+/*
+ * BD-J notifications on presentation time
+ */
+
+static int _pres_holding(BLURAY *bd)
+{
+    return bd->pres_active && bd->title_type == title_bdj;
+}
+
+/* notifications raised from here on belong to the picture at title time due (45 kHz) */
+static void _pres_set_due(BLURAY *bd, uint32_t due)
+{
+    bd->pres_due = _pres_holding(bd) ? (int64_t)due : -1;
+}
+
+static unsigned _pres_state_bit(unsigned ev)
+{
+    switch (ev) {
+        case BDJ_EVENT_CHAPTER:      return 1;
+        case BDJ_EVENT_PLAYITEM:     return 2;
+        case BDJ_EVENT_AUDIO_STREAM: return 4;
+        case BDJ_EVENT_SUBTITLE:     return 8;
+        default:                     return 0;
+    }
+}
+
+/* entries pushed while a playback start is pending wait for its first data */
+static BD_HELD_EVENT *_pres_push(BLURAY *bd)
+{
+    BD_HELD_EVENT *held;
+
+    if (bd->pres_first + bd->pres_count == bd->pres_size) {
+        if (bd->pres_first > 0) {
+            memmove(bd->pres_events, bd->pres_events + bd->pres_first, bd->pres_count * sizeof(*held));
+            bd->pres_first = 0;
+        } else {
+            unsigned size = bd->pres_size ? bd->pres_size * 2 : 16;
+            held = realloc(bd->pres_events, size * sizeof(*held));
+            if (!held) {
+                return NULL;
+            }
+            bd->pres_events = held;
+            bd->pres_size = size;
+        }
+    }
+
+    held = &bd->pres_events[bd->pres_first + bd->pres_count++];
+    memset(held, 0, sizeof(*held));
+    held->armed = bd->pres_start != 1;
+    return held;
+}
+
+static int _pres_hold_event(BLURAY *bd, unsigned ev, unsigned param)
+{
+    BD_HELD_EVENT *held;
+
+    switch (ev) {
+        case BDJ_EVENT_MARK:
+        case BDJ_EVENT_CHAPTER:
+        case BDJ_EVENT_PLAYITEM:
+        case BDJ_EVENT_AUDIO_STREAM:
+        case BDJ_EVENT_SUBTITLE:
+            break;
+        default:
+            return 0;
+    }
+
+    held = _pres_push(bd);
+    if (!held) {
+        BD_DEBUG(DBG_BLURAY | DBG_CRIT, "_pres_hold_event(): out of memory, event %u dropped\n", ev);
+        return 1;
+    }
+
+    held->ev = ev;
+    held->param = param;
+    held->due = (uint32_t)bd->pres_due;
+    held->kind = PRES_BDJ;
+    return 1;
+}
+
+/* the player has data of the playback start or seek */
+static void _pres_data_read(BLURAY *bd)
+{
+    unsigned i;
+
+    if (bd->pres_start == 1) {
+        bd->pres_start = 2;
+    }
+    if (bd->pres_seek == 1) {
+        bd->pres_seek = 2;
+    }
+    for (i = bd->pres_first; i < bd->pres_first + bd->pres_count; i++) {
+        bd->pres_events[i].armed = 1;
+    }
+}
+
+/* the read reached the end of the title. It is due with the last picture, and with no data
+ * read since the playback start, seek or still there is no picture to wait for */
+static void _pres_hold_end(BLURAY *bd)
+{
+    BD_HELD_EVENT *held = NULL;
+
+    _pres_data_read(bd);
+    if (bd->pres_read) {
+        held = _pres_push(bd);
+    }
+
+    if (held) {
+        held->ev = BDJ_EVENT_END_OF_PLAYLIST;
+        held->param = bd_psr_read(bd->regs, PSR_PLAYLIST);
+        held->due = bd->title->duration;
+        held->kind = PRES_END;
+    } else {
+        /* the application gets a pending start ahead of the end */
+        if (bd->pres_start || bd->pres_seek) {
+            bd->pres_start = 0;
+            bd->pres_seek = 0;
+            bdj_presentation_start(bd->bdjava);
+        }
+        bdj_process_event(bd->bdjava, BDJ_EVENT_END_OF_PLAYLIST, bd_psr_read(bd->regs, PSR_PLAYLIST));
+    }
+    bd->end_of_playlist |= 2;
+}
+
+static int _pres_end_held(BLURAY *bd)
+{
+    return bd->pres_count > 0 &&
+           bd->pres_events[bd->pres_first + bd->pres_count - 1].kind == PRES_END;
+}
+
+/* deliver what is due at the presented title time (1/90000 s) */
+static void _pres_release(BLURAY *bd, int64_t title_time)
+{
+    if (bd->pres_start) {
+        /* the player has the events of the start once its first data went out */
+        if (bd->pres_start == 1) {
+            return;
+        }
+        bd->pres_start = 0;
+        bdj_presentation_start(bd->bdjava);
+    }
+
+    /* media time of a seek runs from the first picture after its data was read.
+     * a seek is not presented by the end of the data read before it */
+    if (bd->pres_seek && (title_time == BD_PRESENTED_ALL ? (bd->end_of_playlist & 1) : bd->pres_seek == 2)) {
+        bd->pres_seek = 0;
+        bdj_presentation_start(bd->bdjava);
+    }
+
+    while (bd->pres_count > 0) {
+        BD_HELD_EVENT held = bd->pres_events[bd->pres_first];
+        if (!held.armed || (int64_t)held.due * 2 > title_time) {
+            break;
+        }
+        bd->pres_first++;
+        bd->pres_count--;
+        bdj_process_event(bd->bdjava, held.ev, held.param);
+    }
+    if (!bd->pres_count) {
+        bd->pres_first = 0;
+    }
+}
+
+/* playback leaves the data read: a pending start or seek happened */
+static void _pres_flush_begin(BLURAY *bd)
