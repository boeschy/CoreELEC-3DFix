 src/libbluray/bdj/bdj.h                       |   4 +
 .../bdj/java/org/videolan/Libbluray.java      |  21 ++
 .../org/videolan/media/content/BDHandler.java |  93 ++++-
 .../videolan/media/content/PlayerManager.java |  12 +
 .../media/content/playlist/Handler.java       |   7 +-
 src/libbluray/bluray.c                        | 349 +++++++++++++++++-
 src/libbluray/bluray.h                        |  41 ++
 8 files changed, 593 insertions(+), 9 deletions(-)

diff --git a/src/libbluray/bdj/bdj.c b/src/libbluray/bdj/bdj.c
index dba9d9ee21..fd3961d9da 100644
--- a/src/libbluray/bdj/bdj.c
+++ b/src/libbluray/bdj/bdj.c
@@ -1144,6 +1144,81 @@ void bdj_close(BDJAVA *bdjava)
     X_FREE(bdjava);
 }
 
+int bdj_presentation_hold(BDJAVA *bdjava)
+{
+    JNIEnv *env;
+    int attach = 0;
+    jclass cls;
+    jmethodID mode_id = NULL;
+    int result = 0;
+
+    if (!bdjava) {
+        return 0;
+    }
+
+    if ((*bdjava->jvm)->GetEnv(bdjava->jvm, (void**)&env, JNI_VERSION_1_4) != JNI_OK) {
+        (*bdjava->jvm)->AttachCurrentThread(bdjava->jvm, (void**)&env, NULL);
+        attach = 1;
+    }
+
+    /* quiet lookup: older jars do not have these methods */
+    cls = (*env)->FindClass(env, "org/videolan/Libbluray");
+    if (cls) {
+        if ((*env)->GetStaticMethodID(env, cls, "presentationStart", "()V")) {
+            mode_id = (*env)->GetStaticMethodID(env, cls, "presentationMode", "(Z)V");
+        }
+        if (mode_id) {
+            (*env)->CallStaticVoidMethod(env, cls, mode_id, JNI_TRUE);
+            result = !(*env)->ExceptionOccurred(env);
+        }
+        (*env)->DeleteLocalRef(env, cls);
+    }
+    (*env)->ExceptionClear(env);
+
+    BD_DEBUG(DBG_BDJ, "bdj_presentation_hold(): %s\n", result ? "held" : "not supported");
+
+    if (attach) {
+        (*bdjava->jvm)->DetachCurrentThread(bdjava->jvm);
+    }
+
+    return result;
+}
+
+void bdj_presentation_start(BDJAVA *bdjava)
+{
+    JNIEnv *env;
+    int attach = 0;
+    jclass cls;
+    jmethodID start_id;
+
+    if (!bdjava) {
+        return;
+    }
+
+    BD_DEBUG(DBG_BDJ, "bdj_presentation_start()\n");
+
+    if ((*bdjava->jvm)->GetEnv(bdjava->jvm, (void**)&env, JNI_VERSION_1_4) != JNI_OK) {
+        (*bdjava->jvm)->AttachCurrentThread(bdjava->jvm, (void**)&env, NULL);
+        attach = 1;
+    }
+
+    if (_get_method(env, &cls, &start_id, "org/videolan/Libbluray", "presentationStart", "()V")) {
+        (*env)->CallStaticVoidMethod(env, cls, start_id);
+
+        if ((*env)->ExceptionOccurred(env)) {
+            (*env)->ExceptionDescribe(env);
+            BD_DEBUG(DBG_BDJ | DBG_CRIT, "bdj_presentation_start() failed (uncaught exception)\n");
+            (*env)->ExceptionClear(env);
+        }
+
+        (*env)->DeleteLocalRef(env, cls);
+    }
+
+    if (attach) {
+        (*bdjava->jvm)->DetachCurrentThread(bdjava->jvm);
+    }
+}
+
 int bdj_process_event(BDJAVA *bdjava, unsigned ev, unsigned param)
 {
     static const char * const ev_name[] = {
