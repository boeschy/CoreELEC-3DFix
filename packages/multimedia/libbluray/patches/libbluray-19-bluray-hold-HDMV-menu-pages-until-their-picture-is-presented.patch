         }
         bd->pres_first++;
         bd->pres_count--;
-        bdj_process_event(bd->bdjava, held.ev, held.param);
+        if (held.kind == PRES_GC) {
+            _gc_run_held(bd, &held, NULL);
+        } else {
+            bdj_process_event(bd->bdjava, held.ev, held.param);
+        }
     }
     if (!bd->pres_count) {
         bd->pres_first = 0;
@@ -1690,10 +1815,14 @@ static void _pres_release(BLURAY *bd, int64_t title_time)
 /* playback leaves the data read: a pending start or seek happened */
 static void _pres_flush_begin(BLURAY *bd)
 {
+    _gc_flush(bd, NULL);
+
     if (bd->pres_start || bd->pres_seek) {
         bd->pres_start = 0;
         bd->pres_seek = 0;
-        bdj_presentation_start(bd->bdjava);
+        if (bd->title_type == title_bdj) {
+            bdj_presentation_start(bd->bdjava);
+        }
     }
     bd->pres_raised = 0;
 }
@@ -2422,12 +2551,14 @@ static int _bd_read(BLURAY *bd, unsigned char *buf, int len)
 
                     // handle still mode clips
                     if (st->clip->still_mode == BLURAY_STILL_INFINITE) {
+                        _gc_flush(bd, NULL);
                         bd->pres_read = 0;
                         _queue_event(bd, BD_EVENT_STILL_TIME, 0);
                         return 0;
                     }
                     if (st->clip->still_mode == BLURAY_STILL_TIME) {
                         if (bd->event_queue) {
+                            _gc_flush(bd, NULL);
                             bd->pres_read = 0;
                             _queue_event(bd, BD_EVENT_STILL_TIME, st->clip->still_time);
                             return 0;
@@ -2458,9 +2589,10 @@ static int _bd_read(BLURAY *bd, unsigned char *buf, int len)
                 if (r > 0) {
 
                     if (st->ig_pid > 0) {
-                        if (gc_decode_ts(bd->graphics_controller, st->ig_pid, bd->int_buf, 1, -1) > 0) {
+                        gc_queue_ts(bd->graphics_controller, st->ig_pid, bd->int_buf, 1, st->clip->ref);
+                        if (!bd->gc_held && gc_decode_ts(bd->graphics_controller, st->ig_pid, NULL, 0, -1) > 0) {
                             /* initialize menus */
-                            _run_gc(bd, GC_CTRL_INIT_MENU, 0);
+                            _gc_init_menu(bd);
                         }
                     }
                     if (st->pg_pid > 0) {
@@ -2781,25 +2913,29 @@ static int _bdj_stop_before_presented_end(BLURAY *bd)
            bd->presented_time < (int64_t)bd->title->duration * 2;
 }
 
