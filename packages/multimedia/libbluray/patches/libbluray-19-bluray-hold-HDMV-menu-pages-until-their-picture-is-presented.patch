diff --git a/src/libbluray/bluray.h b/src/libbluray/bluray.h
index 33f83eba3e..0ee3f841d0 100644
--- a/src/libbluray/bluray.h
+++ b/src/libbluray/bluray.h
@@ -1145,11 +1145,16 @@ BD_PUBLIC void bd_set_scr(BLURAY *bd, int64_t pts);
  *  BD_PRESENTED_ALL is reported at the end of the playlist. A seek before the start of
  *  playback is presented keeps the start held.
  *
- *  Must be called before bd_play(). Without a BD-J implementation that supports it
- *  the notifications are not held.
+ *  HDMV menu pages and the page commands behind them are held the same way. User or mouse
+ *  input and a menu call release the held pages early. The page of a closed playlist stays
+ *  until the first picture of the next playlist is reported, unless a seek or resume right
+ *  after the open removes it first.
+ *
+ *  Must be called before bd_play(). Without a BD-J implementation that supports it the
+ *  BD-J notifications are not held; HDMV menu pages are held without BD-J.
  *
  * @param bd  BLURAY object
- * @param enable  1 to hold the notifications, 0 to deliver them when read
+ * @param enable  1 to hold the notifications and HDMV menu pages, 0 to deliver them when read
  */
 BD_PUBLIC void bd_set_presentation_hold(BLURAY *bd, int enable);
 
@@ -1162,6 +1167,8 @@ BD_PUBLIC void bd_set_presentation_hold(BLURAY *bd, int enable);
  *  Held BD-J notifications due at the reported time are delivered. On seek, playlist change
  *  and title change the last held play item, chapter and stream change are delivered unless
  *  the change raised a newer one, and the other held notifications are dropped.
+ *  Held HDMV menu pages are drawn when due, and at once on seek, playlist change, title
+ *  change, still and user input.
  *
  * @param bd  BLURAY object
  * @param title_time title time of the presented picture (1/90000s), -1 if unknown
