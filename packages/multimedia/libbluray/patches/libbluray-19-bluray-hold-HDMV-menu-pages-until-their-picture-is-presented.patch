 }
 
 /*
- * BD-J notifications on presentation time
+ * Notifications, menu pages and the title end on presentation time
  */
 
 static int _pres_holding(BLURAY *bd)
@@ -1604,6 +1606,123 @@ static int _pres_hold_event(BLURAY *bd, unsigned ev, unsigned param)
     return 1;
 }
 
+/*
+ * HDMV menu pages on presentation time
+ */
+
+static int _gc_holding(BLURAY *bd)
+{
+    return bd->pres_hold && bd->title_type == title_hdmv;
+}
+
+static void _gc_hold(BLURAY *bd, gc_ctrl_e ctrl, uint32_t param, uint32_t due)
+{
+    BD_HELD_EVENT *held = _pres_push(bd);
+
+    if (!held) {
+        _run_gc(bd, ctrl, param);
+        return;
+    }
+
+    held->ev = ctrl;
+    held->param = param;
+    held->due = due;
+    held->kind = PRES_GC;
+    bd->gc_held++;
+
+    BD_DEBUG(DBG_BLURAY, "graphics controller %d held, due %" PRIu32 "\n", ctrl, due);
+}
+
+/* a decoded IG composition is due at its pts in the clip it was read from */
+static void _gc_init_menu(BLURAY *bd)
+{
+    const NAV_CLIP *clip;
+    int64_t  pts;
+    uint64_t offset;
+    unsigned src = 0;
+    uint32_t due = 0;
+
+    if (!_gc_holding(bd) || (pts = gc_ig_pts(bd->graphics_controller, &src)) < 0) {
+        _run_gc(bd, GC_CTRL_INIT_MENU, 0);
+        return;
+    }
+
+    /* 33-bit pts. a composition timed before the clip start is due at the clip start */
+    clip = &bd->title->clip_list.clip[src];
+    offset = (uint64_t)(pts - 2 * (int64_t)clip->in_time) & ((UINT64_C(1) << 33) - 1);
+    if (offset < (UINT64_C(1) << 32)) {
+        due = (uint32_t)(offset / 2);
+        if (due > clip->out_time - clip->in_time) {
+            due = clip->out_time - clip->in_time;
+        }
+    }
+
+    _gc_hold(bd, GC_CTRL_INIT_MENU, 0, clip->title_time + due);
+}
+
+/* a preloaded IG sub-path composition is due with the first picture of the playback start */
+static void _gc_init_start(BLURAY *bd)
+{
+    if (_gc_holding(bd) && gc_ig_pts(bd->graphics_controller, NULL) >= 0) {
+        _gc_hold(bd, GC_CTRL_INIT_MENU, 0, _title_time(bd));
+    } else {
+        _run_gc(bd, GC_CTRL_INIT_MENU, 0);
+    }
+}
+
+/* a page command waits behind the held page it applies to */
+static void _gc_run_or_hold(BLURAY *bd, gc_ctrl_e ctrl, uint32_t param)
+{
+    if (bd->gc_held) {
+        _gc_hold(bd, ctrl, param, bd->pres_events[bd->pres_first + bd->pres_count - 1].due);
+    } else {
+        _run_gc(bd, ctrl, param);
+    }
+}
+
+static void _gc_run_held(BLURAY *bd, const BD_HELD_EVENT *held, int *nav)
+{
+    bd->gc_held--;
+    _run_gc_cmds(bd, (gc_ctrl_e)held->ev, held->param, nav);
+
+    /* IG decoding waits while an entry is held: the decoder updates the composition in place */
+    if (!bd->gc_held && bd->st0.ig_pid > 0 &&
+        gc_decode_ts(bd->graphics_controller, bd->st0.ig_pid, NULL, 0, -1) > 0) {
+        _gc_init_menu(bd);
+    }
+}
+
+/* run every held entry and every IG composition queued behind them */
+static void _gc_flush(BLURAY *bd, int *nav)
+{
+    while (bd->gc_held) {
+        unsigned i = bd->pres_first;
+        BD_HELD_EVENT held;
+
+        while (bd->pres_events[i].kind != PRES_GC) {
+            i++;
+        }
+        held = bd->pres_events[i];
+        memmove(bd->pres_events + i, bd->pres_events + i + 1,
+                (bd->pres_first + bd->pres_count - i - 1) * sizeof(held));
+        bd->pres_count--;
+
+        _gc_run_held(bd, &held, nav);
+    }
+}
+
+/* user input acts on the held page: it decides the UO mask, and its auto action
+ * replaces the HDMV object the input would set (returns 1) */
+static int _gc_flush_input(BLURAY *bd)
+{
+    int nav = 0;
+
+    if (bd->title_type == title_hdmv) {
+        _gc_flush(bd, &nav);
+    }
+    return nav;
+}
