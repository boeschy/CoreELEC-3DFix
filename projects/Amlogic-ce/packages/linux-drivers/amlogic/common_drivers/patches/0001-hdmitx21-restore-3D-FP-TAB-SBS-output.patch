+static u32 hdmitx21_para_pixel_freq(const struct hdmi_format_para *para)
+{
+	const struct hdmi_timing *base = hdmitx_mode_vic_to_hdmi_timing(para->timing.vic);
+	u32 pixel_freq = para->timing.pixel_freq;
+
+	if (para->flag_3dfp && base && pixel_freq <= base->pixel_freq)
+		pixel_freq *= 2;
+
+	return pixel_freq;
+}
