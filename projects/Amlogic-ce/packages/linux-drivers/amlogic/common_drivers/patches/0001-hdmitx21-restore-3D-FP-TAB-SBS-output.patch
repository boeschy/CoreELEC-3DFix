+/*
+ * A 3D frame packing modeline (e.g. 1920x2205 for 1080p, 1280x1470 for 720p)
+ * is two 2D frames plus one active space and matches no CEA mode. Fold it
+ * back to its 2D equivalent so that the CEA match and the alternate
+ * (1000/1001) clock detection work for frame packing as well.
+ */
+static bool meson_hdmitx_fp_to_2d_mode(const struct drm_display_mode *fp,
+				       struct drm_display_mode *mode2d)
+{
+	static const struct {
+		u16 vdisplay;
+		u16 vblank;
+	} fp_fmt[] = {
+		{ 720, 30 },
+		{ 1080, 45 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(fp_fmt); i++) {
+		u16 vd = fp_fmt[i].vdisplay;
+		u16 vb = fp_fmt[i].vblank;
+
+		if (fp->vdisplay != 2 * vd + vb || fp->vtotal != 2 * (vd + vb))
+			continue;
+
+		*mode2d = *fp;
+		mode2d->clock = fp->clock / 2;
+		mode2d->vdisplay = vd;
+		mode2d->vsync_start = vd + (fp->vsync_start - fp->vdisplay);
+		mode2d->vsync_end = vd + (fp->vsync_end - fp->vdisplay);
+		mode2d->vtotal = vd + vb;
+		return true;
+	}
+
+	return false;
+}
