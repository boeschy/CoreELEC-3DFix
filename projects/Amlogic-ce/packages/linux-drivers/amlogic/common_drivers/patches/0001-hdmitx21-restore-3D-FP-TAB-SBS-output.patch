+/*
+ * Only the 3D part of the 5.15 config node is supported. The request takes
+ * effect with the next mode set:
+ *   3dfp                     frame packing
+ *   3dtb | 3dtab             top and bottom
+ *   3dlr | 3dss | 3dsbs [n]  side by side (half), n = 3D_Ext_Data (0..15)
+ *   3doff                    disable 3D
+ */
+static ssize_t config_store(struct device *dev,
+	struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct hdmitx_common *tx_comm = dev_get_drvdata(dev);
+	unsigned long ext = 0;
+	u8 req;
+
+	if (strncmp(buf, "3dfp", 4) == 0) {
+		req = HDMITX_REQ_3D_FP;
+	} else if (strncmp(buf, "3dtb", 4) == 0 || strncmp(buf, "3dtab", 5) == 0) {
+		req = HDMITX_REQ_3D_TB;
+	} else if (strncmp(buf, "3dlr", 4) == 0 || strncmp(buf, "3dss", 4) == 0 ||
+		   strncmp(buf, "3dsbs", 5) == 0) {
+		const char *arg = strchr(buf, ' ');
+
+		req = HDMITX_REQ_3D_SS;
+		if (arg && kstrtoul(skip_spaces(arg), 10, &ext))
+			return -EINVAL;
+		if (ext > 0xf)
+			return -EINVAL;
+	} else if (strncmp(buf, "3doff", 5) == 0) {
+		req = HDMITX_REQ_3D_OFF;
+	} else {
+		return -EINVAL;
+	}
+
+	mutex_lock(&tx_comm->hdmimode_mutex);
+	tx_comm->req_3d = req;
+	tx_comm->req_3d_ext = ext;
+	hdmitx_common_apply_3d_live(tx_comm);
+	mutex_unlock(&tx_comm->hdmimode_mutex);
+
+	return count;
+}
