+/* 3D frame packing is only supported for these modes */
+static bool hdmitx_common_vic_support_3dfp(enum hdmi_vic vic)
+{
+	switch (vic) {
+	case HDMI_19_1280x720p50_16x9:
+	case HDMI_4_1280x720p60_16x9:
+	case HDMI_32_1920x1080p24_16x9:
+	case HDMI_33_1920x1080p25_16x9:
+	case HDMI_34_1920x1080p30_16x9:
+	case HDMI_31_1920x1080p50_16x9:
+	case HDMI_16_1920x1080p60_16x9:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/*
+ * announce the 3D structure in the HDMI 1.4 vendor specific infoframe.
+ * Same layout as the 5.15 hdmi21_set_3d(): length 6, PB6 = 3D_Ext_Data.
+ */
+int hdmitx_common_setup_3d_vsif(struct hdmitx_common *tx_comm, u8 req)
+{
+	u8 buffer[31] = {0x81, 0x01, 0x06, 0};
+	u8 structure;
+
+	if (!tx_comm || !tx_comm->tx_hw)
+		return -EINVAL;
+
+	switch (req) {
+	case HDMITX_REQ_3D_FP:
+		structure = T3D_FRAME_PACKING;
+		break;
+	case HDMITX_REQ_3D_TB:
+		structure = T3D_TAB;
+		break;
+	case HDMITX_REQ_3D_SS:
+		structure = T3D_SBS_HALF;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	buffer[4] = GET_OUI_BYTE0(HDMI_IEEE_OUI);
+	buffer[5] = GET_OUI_BYTE1(HDMI_IEEE_OUI);
+	buffer[6] = GET_OUI_BYTE2(HDMI_IEEE_OUI);
+	/* HDMI_Video_Format: 3D present */
+	buffer[7] = 0x40;
+	buffer[8] = structure << 4;
+	if (req == HDMITX_REQ_3D_SS)
+		buffer[9] = (READ_ONCE(tx_comm->req_3d_ext) & 0xf) << 4;
+	hdmitx_hw_cntl(tx_comm->tx_hw, AUX_PKT_SET_VSIF1, buffer, NULL);
+
+	return 0;
+}
+
+/*
+ * Userspace (Kodi on T7 and newer) selects side-by-side / top-and-bottom /
+ * off *after* the mode set. These need no timing change, so apply them to the
+ * running output right away. Frame packing changes the timing and only takes
+ * effect with the next mode set.
+ */
+void hdmitx_common_apply_3d_live(struct hdmitx_common *tx_comm)
+{
+	struct meson_tx_format_para *para = &tx_comm->fmt_para;
+	u8 req = READ_ONCE(tx_comm->req_3d);
+
+	if (!tx_comm->ready || req == HDMITX_REQ_3D_FP || para->flag_3dfp)
+		return;
+
+	para->flag_3dtb = (req == HDMITX_REQ_3D_TB);
+	para->flag_3dss = (req == HDMITX_REQ_3D_SS);
+
+	if (req == HDMITX_REQ_3D_OFF || hdmitx_edid_get_hdmi14_4k_vic(para->tx_hw_para.hdmitx_hw_para.vic) > 0)
+		/* sets the 4k vsif for 4k modes and clears it otherwise */
+		hdmitx_common_setup_vsif_packet(tx_comm, VT_HDMI14_4K, 0, NULL);
+	else
+		hdmitx_common_setup_3d_vsif(tx_comm, req);
+}
+
+/* carry the requested 3D mode over to a freshly initialized format para */
+static void hdmitx_common_apply_3d_request(struct hdmitx_common *tx_comm,
+					   struct meson_tx_format_para *para)
+{
+	para->flag_3dfp = 0;
+	para->flag_3dtb = 0;
+	para->flag_3dss = 0;
+
+	switch (READ_ONCE(tx_comm->req_3d)) {
+	case HDMITX_REQ_3D_FP:
+		if (hdmitx_common_vic_support_3dfp(para->tx_hw_para.hdmitx_hw_para.vic)) {
+			para->flag_3dfp = 1;
+			/* the 3D frame packing clock setup only exists for 8 bit */
+			para->cd = COLORDEPTH_24B;
+		}
+		break;
+	case HDMITX_REQ_3D_TB:
+		para->flag_3dtb = 1;
+		break;
+	case HDMITX_REQ_3D_SS:
+		para->flag_3dss = 1;
+		break;
+	default:
+		break;
+	}
+}
